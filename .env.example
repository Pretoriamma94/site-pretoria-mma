# Supabase — créer un projet sur https://supabase.com/dashboard
# Puis copier les clés depuis Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (emails)
RESEND_API_KEY=
# Expéditeur (domaine vérifié Resend) — sinon onboarding@resend.dev (tests)
# CONTACT_FROM_EMAIL="Pretoria MMA <noreply@votredomaine.fr>"
# Destinataire messages contact (défaut : pretoriamma94@gmail.com)
# CONTACT_TO_EMAIL=pretoriamma94@gmail.com

# HelloAsso (paiements)
NEXT_PUBLIC_HELLOASSO_URL=

# Cloudflare Turnstile (anti-spam)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Dev local uniquement — accès /admin sans login (jamais en production)
# ADMIN_AUTH_BYPASS=true
